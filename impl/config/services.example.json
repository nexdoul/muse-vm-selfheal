{
  "version": 1,
  "services": [
    {
      "id": "example-running",
      "desired_state": "running",
      "home": "/tmp",
      "workdir": "/tmp",
      "environment": {"EXAMPLE_VALUE": "demo"},
      "environment_file": "/dev/null",
      "health_check": "/bin/true",
      "health_timeout_sec": 2,
      "stopped_check": "exit 0"
    },
    {
      "id": "example-stopped",
      "desired_state": "stopped",
      "home": "/tmp",
      "workdir": "/tmp",
      "environment_file": "/dev/null",
      "health_check": "/bin/true",
      "health_timeout_sec": 2,
      "stopped_check": "exit 0"
    }
  ]
}
