[Unit]
Description=Muse VM local sshd (persistent, localhost only)
After=default.target
Wants=default.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/hatch/selfheal/bin/sshd-run.sh
WorkingDirectory=/home/hatch/selfheal
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group

[Install]
WantedBy=default.target
